<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sirahanairo"
    android:padding="16dp"
    tools:context=".ui.settings.SettingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 有料会員特典セクション -->
        <TextView
            android:id="@+id/premium_features_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium_features_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/premium_features_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium_features_description"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp" />

        <!-- 特典リスト -->
        <TextView
            android:id="@+id/premium_feature_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium_feature_ads"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp" />

        <TextView
            android:id="@+id/premium_feature_barcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium_feature_barcode"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="16dp" />

        <!-- 現在のステータス -->
        <TextView
            android:id="@+id/current_status_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/current_status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/membership_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/free_member"
            android:textSize="16sp"
            android:textColor="@color/appcolor"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- 購入ボタン -->
        <Button
            android:id="@+id/subscribe_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/become_premium"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@+id/membership_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:backgroundTint="@color/appcolor"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
