<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sirahanairo"
    android:padding="4dp"
    tools:context=".ui.settings.SettingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 定期購入関連のCardView -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/geppaku"
            app:cardCornerRadius="6dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="4dp"
                android:orientation="vertical">

                <!-- 有料会員特典セクション -->
                <TextView
                    android:id="@+id/premium_features_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_features_title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/premium_features_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_features_description"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="16dp" />

                <!-- 特典リスト -->
                <TextView
                    android:id="@+id/premium_feature_ads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_feature_ads"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/premium_feature_barcode"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/feature_description_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/feature_description_link"
                        android:textSize="14sp"
                        android:textColor="@color/appcolor"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp"
                        android:drawablePadding="4dp"
                        app:drawableTint="@color/appcolor"
                        app:drawableRightCompat="@drawable/ic_baseline_open_in_browser_24" />

                </LinearLayout>

                <!-- 現在のステータス -->
                <TextView
                    android:id="@+id/current_status_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/current_status"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/membership_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/free_member"
                    android:textSize="16sp"
                    android:textColor="@color/appcolor"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- 購入ボタン -->
                <Button
                    android:id="@+id/subscribe_button_monthly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/become_premium_monthly"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/round_button"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/subscribe_button_yearly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/become_premium_yearly"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/round_button"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/yearly_promotion_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yearly_promotion"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:gravity="end"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- プライバシーポリシーのCardView -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/geppaku"
            app:cardCornerRadius="6dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/privacy_policy_title"
                    android:textSize="16sp"
                    android:textColor="@color/black" />

                <Button
                    android:id="@+id/privacy_policy_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/move_button"
                    android:textSize="14sp"
                    android:background="@drawable/round_button"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- アプリ評価のCardView -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/geppaku"
            app:cardCornerRadius="6dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_evaluation_title"
                    android:textSize="16sp"
                    android:textColor="@color/black" />

                <Button
                    android:id="@+id/app_evaluation_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/move_button"
                    android:textSize="14sp"
                    android:background="@drawable/round_button"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
